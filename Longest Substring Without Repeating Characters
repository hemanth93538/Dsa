class Solution(object):
    def lengthOfLongestSubstring(self, s):
        char_set = set()
        left = 0
        max_length = 0

        for right in range(len(s)):
            while s[right] in char_set:
                char_set.remove(s[left])
                left += 1

            char_set.add(s[right])   # ✅ FIXED
            max_length = max(max_length, right - left + 1)   # ✅ FIXED

        return max_length
